{
  "repo": "C:/path/to/your-repo",
  "port": 4317,
  "sessionCwdMatch": "your-repo",
  "coordinator": "Coordinator",
  "codingAgents": {
    "Coordinator": "Coordinator",
    "Agent 1": "Agent 1",
    "Agent 2": "Agent 2",
    "my-session-name": "Agent 3"
  },
  "aliases": {
    "some-session": "A friendlier name"
  },
  "stopHour": null,
  "ticketPrefixes": ["ABC"],
  "reminders": [
    { "at": "17:55", "days": "weekdays", "text": "Wrap up: commit or park your work." }
  ],
  "standup": {
    "author": "",
    "name": "Your Name",
    "project": "Your project",
    "base": "",
    "ticketUrl": "https://app.switchboardpm.ai/stories/{id}"
  },
  "factory": {
    "collections": [
      {
        "id": "main",
        "name": "Main board",
        "kind": "switchboard",
        "project": "YOUR_PROJECT_ID",
        "tools": ["mcp__switchboard-claude__list_stories"],
        "filter": {
          "prefix": "ABC",
          "range": [100, 199],
          "extras": []
        },
        "plan": "C:/path/to/your-repo/docs/plan.md",
        "refreshMinutes": 0
      },
      {
        "id": "beta",
        "name": "A board only a browser can read",
        "kind": "agent",
        "ask": "Open https://example.com/board in the browser and read every card (id, title, column, owner).",
        "tools": ["mcp__playwright__*"],
        "refreshMinutes": 0
      }
    ],
    "me": "your-tracker-user-id",
    "chat": {
      "name": "Independent",
      "forkFrom": "",
      "model": "claude-opus-5-5",
      "mode": "brief"
    },
    "relayModel": "claude-sonnet-5-5",
    "explainModel": "claude-haiku-5-5"
  },
  "claudeDirs": [],
  "tokens": {
    "note": "Dollars per million tokens, read from the public pricing page on 2026-11-25. Prices change: keeping them current is yours. A model takes its exact id, else the longest id it starts with. null means no price for that id and every id under it with no price of its own, never a shorter id.",
    "prices": {
      "claude-opus-5-5": { "input": 4, "output": 20, "cacheWrite": 5, "cacheWrite1h": 8, "cacheRead": 0.2 },
      "claude-opus-5": { "input": 5, "output": 25, "cacheWrite": 6.25, "cacheWrite1h": 10, "cacheRead": 0.5 },
      "claude-sonnet-5-5": { "input": 2, "output": 10, "cacheWrite": 2.5, "cacheWrite1h": 4, "cacheRead": 0.1 },
      "claude-fable-5-2": { "input": 8, "output": 40, "cacheWrite": 10, "cacheWrite1h": 16, "cacheRead": 0.2 },
      "claude-fable-5-1": { "input": 10, "output": 50, "cacheWrite": 12.5, "cacheWrite1h": 20, "cacheRead": 0.25 }
    }
  },
  "outputs": { "max": 7, "warnAfterDays": 2 },
  "healing": { "enabled": true, "repairs": true },
  "insight": { "notifyMaster": "off" },
  "alerts": {
    "enabled": true,
    "stuckFactor": 3,
    "stuckMinMinutes": 60,
    "stuckHours": 24,
    "spikeFactor": 4,
    "spikeMinTokens": 20000000,
    "contextTokens": 400000,
    "dailyUsd": null,
    "dailyTokens": null
  },
  "estimates": { "enabled": true, "nearest": 8 },
  "learn": { "enabled": true, "autoRetro": true, "weekly": false, "verdictAfterDays": 14, "model": "claude-opus-5-5", "retroModel": "claude-sonnet-5-5" },
  "pipeline": {
    "qa": "QA",
    "producers": null,
    "protectedBranches": ["dev", "stage", "main", "master"],
    "maxReworks": 3,
    "planner": null,
    "security": null,
    "senior": null,
    "requireSelfCheck": false
  },
  "quality": { "autoLessons": true, "critic": "manual", "areas": [], "riskRules": null },
  "pr": {
    "enabled": false,
    "remote": "origin",
    "bases": ["dev"],
    "gh": "gh"
  },
  "routing": {
    "intakeModel": null,
    "rules": [
      { "when": { "risk": "high" }, "model": "claude-opus-5-5", "effort": "high", "why": "high-risk work gets the strongest model" },
      { "when": { "type": "wording", "size": "small" }, "model": "claude-sonnet-5-5", "effort": "medium", "why": "small wording fixes rarely fail QA" }
    ]
  },
  "remote": { "enabled": false, "bind": "", "port": 4318, "pinHash": "", "sessionHours": 4 }
}
